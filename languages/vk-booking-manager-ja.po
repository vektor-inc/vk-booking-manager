msgid "Resource name (multiple)"
msgstr "リソース名称（複数）"

#: src/admin/class-provider-settings-page.php:1676
msgid "Used for plural notation in lists, menu names, etc."
msgstr "一覧・メニュー名など、複数形の表記に利用します。"

