#: src/admin/class-provider-settings-page.php:2127
msgid "Use (optional)"
msgstr "使用する（入力は任意）"

#: src/admin/class-provider-settings-page.php:2128
msgid "Use (required)"
msgstr "使用する（入力を必須にする）"

