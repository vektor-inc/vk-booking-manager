#: src/attendees/class-attendee-roster-user-profile.php:125
#: src/attendees/class-attendee-roster-user-profile.php:150
#: src/auth/class-auth-shortcodes.php:853
#: src/auth/class-auth-shortcodes.php:883
#: src/auth/class-auth-shortcodes.php:1128
