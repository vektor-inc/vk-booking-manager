#: src/admin/class-provider-settings-page.php:1925
msgid "resource label"
msgstr "リソースラベル"

#: src/admin/class-provider-settings-page.php:1936
msgid "Replaces the \"available staff\" notation in the menu card."
msgstr "メニューカード内の「担当可能スタッフ」表記を置き換えます。"

