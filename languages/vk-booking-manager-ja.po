msgid ""
"This is intended for tours where strangers should not share the same slot "
"(e.g. SUP, diving)."
msgstr "知らない人同士が同席しないツアー（SUP・ダイビング等）向けの設定です。"

#: src/admin/class-service-menu-editor.php:2164
msgid "Private booking by customer"
msgstr "予約者による貸切指定"

#: src/admin/class-service-menu-editor.php:2168
