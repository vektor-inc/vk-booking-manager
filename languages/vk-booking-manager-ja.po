#: src/admin/class-service-menu-editor.php:2379
msgid "Pre-holidays and special dates on the General Settings page"
msgstr "基本設定画面の「休前日・特定日」"

#: src/admin/class-service-menu-editor.php:2389
msgid "Price categories are set, so the basic price is not used."
msgstr "料金区分が設定されているため、基本料金は使われません。"

#: src/admin/class-service-menu-editor.php:2415
msgid "Price (regular)"
msgstr "料金（平日）"

#: src/admin/class-service-menu-editor.php:2416
msgid "Category name"
msgstr "区分名"

#: src/admin/class-service-menu-editor.php:2435
#: src/post-types/class-service-menu-post-type.php:553
msgid "Price categories"
msgstr "料金区分"

#: src/admin/class-service-menu-editor.php:2500
msgid "+ Add price category"
msgstr "＋ 料金区分を追加"

