msgstr "Media Library からロゴ画像を選択します（任意）。"

#: src/admin/class-provider-settings-page.php:2052
#: src/blocks/reservation/booking-confirm-app.js:1527
#: src/blocks/reservation/components/footer-model.js:103
msgid "Cancellation policy"
msgstr "キャンセルポリシー"

#: src/admin/class-provider-settings-page.php:2061
