msgstr "画像を選択"

#: src/admin/class-provider-settings-page.php:2448
msgid "delete image"
msgstr "画像を削除"

#: src/admin/class-provider-settings-page.php:2450
msgid "Select a logo image from your Media Library (optional)."
msgstr "Media Library からロゴ画像を選択します（任意）。"

