bf\u3092\u8aad\u307f\u8fbc\u3081\u307e\u305b\u3093\u3067\u3057\u305f\u3002\u4e88\u7d04\u30da\u30fc\u30b8\u304b\u3089\u518d\u5ea6\u304a\u8a66\u3057\u304f\u3060\u3055\u3044\u3002"],"Could not add to favorites.":["\u304a\u6c17\u306b\u5165\u308a\u306b\u767b\u9332\u3067\u304d\u307e\u305b\u3093\u3067\u3057\u305f\u3002"],"Confirmation of reservation failed. Please try again later.":["\u4e88\u7d04\u306e\u78ba\u8a8d\u306b\u5931\u6557\u3057\u307e\u3057\u305f\u3002\u3057\u3070\u3089\u304f\u3057\u3066\u304b\u3089\u3082\u3046\u4e00\u5ea6\u304a\u8a66\u3057\u304f\u3060\u3055\u3044\u3002"],"Loading temporary reservation data\u2026":["\u4e00\u6642\u4e88\u7d04\u30c7\u30fc\u30bf\u3092\u8aad\u307f\u8fbc\u307f\u4e2d\u2026"],"Your tentative reservation has been received.":["\u4eee\u4e88\u7d04\u3092\u53d7\u3051\u4ed8\u3051\u307e\u3057\u305f"],"No entry":["\u8a18\u5165\u306a\u3057"],"I agree to the cancellation policy":["\u30ad\u30e3\u30f3\u30bb\u30eb\u30dd\u30ea\u30b7\u30fc\u306b\u540c\u610f\u3057\u307e\u3059"],"Save these details so you can quickly book the same thing again next time (add to favorites)":["\u3053\u306e\u4e88\u7d04\u5185\u5bb9\u3067\u6b21\u56de\u3082\u3059\u3050\u4e88\u7d04\u3067\u304d\u308b\u3088\u3046\u306b\u3059\u308b\uff08\u304a\u6c17\u306b\u5165\u308a\u767b\u9332\uff09"],"Private (exclusive use of this slot)":["\u8cb8\u5207\uff08\u3053\u306e\u67a0\u3092\u5c02\u6709\uff09"],"You must log in to confirm your reservation.":["\u4e88\u7d04\u3092\u78ba\u8a8d\u3059\u308b\u306b\u306f\u30ed\u30b0\u30a4\u30f3\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002"],"Sign up":["\u65b0\u898f\u767b\u9332"],"Requests\/Notes":["\u3054\u8981\u671b\u30fb\u5099\u8003"],"Reserved name":["\u4e88\u7d04\u8005\u540d"],"Please enter customer name.":["\u304a\u540d\u524d\u3092\u5165\u529b\u3057\u3066\u304f\u3060\u3055\u3044\u3002"],"Please enter your contact phone number.":["\u3054\u9023\u7d61\u5148\u306e\u96fb\u8a71\u756a\u53f7\u3092\u5165\u529b\u3057\u3066\u304f\u3060\u3055\u3044\u3002"]