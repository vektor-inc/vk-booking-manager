{
  "apiVersion": 3,
  "name": "vk-booking-manager/reservation-button",
  "title": "Proceed to Reservation Button",
  "description": "Display a button that links to the reservation page for the current plan.",
  "category": "vk-booking-manager",
  "icon": "button",
  "textdomain": "vk-booking-manager",
  "keywords": [
    "reservation",
    "booking",
    "button"
  ],
  "attributes": {
    "menuId": {
      "type": "number",
      "default": 0
    },
    "label": {
      "type": "string",
      "default": ""
    }
  },
  "supports": {
    "align": [
      "wide",
      "full"
    ],
    "anchor": true,
    "customClassName": true,
    "color": {
      "background": true,
      "text": true
    },
    "spacing": {
      "margin": true,
      "padding": true
    },
    "__experimentalBorder": {
      "radius": true
    }
  },
  "style": "file:./style-index.css",
  "editorStyle": "file:./index.css",
  "editorScript": "file:./index.js"
}